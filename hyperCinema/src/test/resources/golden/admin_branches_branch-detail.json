    {
      "action": "/admin/branches/11/status",
      "method": "post",
      "fields": [
        "select:status=options[Active|Inactive|Maintenance];selected=Active",
        "submit:Đổi"
      ]
    },
    {
      "action": "/admin/branches/11/staff",
      "method": "post",
      "fields": [
        "userId(number)=",
        "managerId(number)=",
        "submit:Gán Staff"
      ]
    },
    {
      "action": "/admin/branches/11",
      "method": "post",
      "fields": [
        "_method(hidden)=delete",
        "submit:Xoá"
      ]
    },
    {
